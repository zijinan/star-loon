#!name=酷狗概念版去广告
#!desc=移除开屏广告（酷狗自有/TME联盟/广点通/穿山甲等SDK）、广告服务模块、播放器广告，精简乐库及搜索页面；激励/插屏广告倒计时加速（5秒浏览→1秒）。
#!openUrl=https://apps.apple.com/app/id1480205582
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuGouYouth.png
#!date=2026-11-03 23:00:00
#!version=1.1.2

[Rule]
# 广点通(GDT/优量汇) 开屏拉取与素材
DOMAIN,us.l.qq.com,REJECT
DOMAIN,xs.gdt.qq.com,REJECT
DOMAIN,tangram.e.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,sdkreport.e.qq.com,REJECT
DOMAIN,p.l.qq.com,REJECT
DOMAIN,monitor.l.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,v.gdt.qq.com,REJECT
DOMAIN,rpt.gdt.qq.com,REJECT
# TME 广告联盟 SDK 配置/策略/上报
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT
# 酷狗广告服务
DOMAIN,adservice.kugou.com,REJECT
# 穿山甲(Pangle)/字节
DOMAIN,sf3-fe-tos.pglstatp-toutiao.com,REJECT
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT
DOMAIN,mssdk.volces.com,REJECT
# 第三方 DSP/监测
DOMAIN,im-x.jd.com,REJECT
DOMAIN,ccc-wt.jd.com,REJECT
DOMAIN-SUFFIX,miaozhen.com,REJECT

[Rewrite]
# 广点通开屏拉取（京东互动开屏等），规则之外再以 MitM 兜底
request if ${url} ~= /^https:\/\/us\.l\.qq\.com\/exapp/i then reject_dict(200)

# 本地规则优先级高于插件规则，若本地/全局规则先命中则插件 [Rule] 不生效，这里以 MitM 复写兜底
request if ${url} ~= /^https:\/\/(xs|mi|v|rpt)\.gdt\.qq\.com\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/tangram\.e\.qq\.com\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/sdkreport\.e\.qq\.com\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/pgdt\.gtimg\.cn\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/im-x\.jd\.com\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/mc\.tencentmusic\.com\/sdk\/ad\/strategies/i then reject_dict(200)

request if ${url} ~= /^https:\/\/tmeadcomm\.y\.qq\.com\/maproxy\/getPbCompressAd/i then reject_dict(200)

request if ${url} ~= /^https:\/\/tmeadcomm\.y\.qq\.com\/mareportbatch\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/ads\.service\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/start_img\/last\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/yueku\/tab\?/i then response.json.jq(".data.responses |= map(select(.module == \"new_song_publish\" or .module == \"song_rank\"))")

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/ads\.gateway\//i then reject_dict(200)

request if ${url} ~= /^http:\/\/mobilelog\.kugou\.com\/adtrackconfig\.json$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/experiment\/get_params\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/api\/user\/v1\/init\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v2\/activity\/task_list\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/youth\/v1\/channel\/tab_list\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/gateway\.kugou\.com\/goddess\/v1\/content\/biz_list\?/i then reject_dict(200)

[Script]
http-response ^https:\/\/tmeadcomm\.y\.qq\.com\/maproxy\/getAd$ script-path=https://raw.githubusercontent.com/zijinan/star-loon/main/scripts/zijinan/KuGouYouth/ad_speedup.js, requires-body=true, timeout=10, tag=酷狗概念版广告倒计时加速

[MitM]
hostname=gateway.kugou.com, tmeadcomm.y.qq.com, us.l.qq.com, *.gdt.qq.com, tangram.e.qq.com, sdkreport.e.qq.com, pgdt.gtimg.cn, im-x.jd.com, mc.tencentmusic.com